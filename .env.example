# Modelo de configuração. Copie para .env e troque as senhas:
#
#   cp .env.example .env
#
# Gere senhas fortes, por exemplo:
#   openssl rand -base64 24
#
# O .env não é versionado (ver .gitignore) e não entra na imagem (ver .dockerignore).

MYSQL_ROOT_PASSWORD=troque-esta-senha-do-root
DB_NAME=minhas_contas
DB_USER=contas
DB_PASS=troque-esta-senha-da-aplicacao

# Conta promovida a administrador na primeira inicialização, enquanto ainda não
# houver nenhum admin no sistema.
ADMIN_EMAIL=admin@seu-dominio.com

# production: erros viram 500 genérico. development: a mensagem real aparece na
# resposta — só use fora de um servidor exposto.
APP_ENV=production

# Endereço público da aplicação, usado no link do e-mail de redefinição de
# senha. Sem barra no final. Ex.: https://contas.seu-dominio.com.br
#
# Vem daqui, e não do cabeçalho Host da requisição, de propósito: quem pede a
# redefinição controla esse cabeçalho e poderia fazer o e-mail da vítima
# apontar para o domínio dele, com o token válido dentro.
#
# Vazio é aceitável — o fluxo continua funcionando, e o e-mail vai só com o
# código, para colar na tela.
APP_URL=

# Cria e alimenta a conta de demonstração 'planilha' a cada boot. Desligue
# (false) depois da configuração inicial em produção: senão, excluir a conta
# não pega — ela volta no próximo restart do container.
SEED_DEMO_ACCOUNT=true

# Envio do código de ativação de conta por e-mail, via Brevo (SMTP relay
# gratuito, sem cartão). Em Configurações > SMTP & API > aba SMTP estão os
# dois valores: o "Fazer login" (um identificador gerado, no formato
# xxxxx@smtp-brevo.com — não é o e-mail da sua conta) e a "SMTP key".
#
# O remetente precisa de domínio próprio autenticado (SPF/DKIM/DMARC) em
# Configurações > Remetentes, Domínios e IPs: endereço @gmail.com e afins
# são recusados pelas regras de Google/Yahoo/Microsoft.
#
# Atenção: se a allowlist estiver ligada (Configurações > Segurança > IPs
# autorizados), o IP de saída do servidor precisa estar lá, senão o login
# falha com "525 5.7.1 Unauthorized IP address".
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=troque-para-o-login-smtp-do-painel-brevo
SMTP_PASS=troque-para-a-smtp-key-gerada-no-painel-brevo
SMTP_FROM_EMAIL=noreply@seu-dominio-autenticado
SMTP_FROM_NOME=Minhas Contas

# Chave de cifragem dos segredos de MFA (TOTP), 32 bytes em base64. Gere com:
#   openssl rand -base64 32
# Trocar esta chave torna os segredos já cadastrados indecifráveis — trate
# como incidente, não como rotina (o admin pode resetar o MFA de uma conta
# pelo painel; a pessoa cadastra o autenticador de novo).
MFA_ENCRYPTION_KEY=troque-esta-chave-de-32-bytes-em-base64
